{
  "name": "catalysteria/laravel-ussd",
  "description": "USSD application builder for Laravel 8-12 with session continuity",
  "type": "library",
  "license": "MIT",
  "version": "1.0.7",
  "keywords": [
    "laravel",
    "ussd",
    "session",
    "continuity"
  ],
  "authors": [
    {
      "name": "Your Name",
      "email": "you@example.com"
    }
  ],
  "require": {
    "php": "^8.1",
    "illuminate/support": "^8.0|^9.0|^10.0|^11.0|^12.0",
    "illuminate/console": "^8.0|^9.0|^10.0|^11.0|^12.0",
    "illuminate/cache": "^8.0|^9.0|^10.0|^11.0|^12.0",
    "illuminate/events": "^8.0|^9.0|^10.0|^11.0|^12.0",
    "illuminate/routing": "^8.0|^9.0|^10.0|^11.0|^12.0",
    "illuminate/http": "^8.0|^9.0|^10.0|^11.0|^12.0",
    "illuminate/filesystem": "^8.0|^9.0|^10.0|^11.0|^12.0",
    "illuminate/contracts": "^8.0|^9.0|^10.0|^11.0|^12.0"
  },
  "require-dev": {
    "orchestra/testbench": "~6|~7|~8|~9|~10|~11",
    "phpunit/phpunit": "^9.6"
  },
  "autoload": {
    "psr-4": {
      "Vendor\\LaravelUssd\\": "src/"
    },
    "files": [
      "src/Support/laravel-contracts-stub.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Vendor\\LaravelUssd\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Vendor\\LaravelUssd\\Providers\\LaravelUssdServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit"
  },
  "minimum-stability": "dev"
}
